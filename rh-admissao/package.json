{
  "name": "rh-admissao",
  "version": "0.1.0",
  "private": true,
  "description": "Admissão por link: o contratado manda documentos pelo celular e o RH conclui com o pacote da contabilidade.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "pg": "8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "prisma": "7.10.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
